<nav class="fixed w-full z-50 transition-all duration-300" 
     x-data="{ scrolled: false, mobileMenuOpen: false }" 
     @scroll.window="scrolled = (window.pageYOffset > 20)"
     :class="scrolled || mobileMenuOpen ? 'bg-white/95 backdrop-blur-md shadow-md py-3' : 'bg-transparent py-5'">
    
    <div class="container mx-auto px-6">
        <div class="flex justify-between items-center">
            
            <a href="/" class="flex items-center gap-3 group relative z-50">
                <% if (site.logoUrl) { %>
                    <img src="<%= site.logoUrl %>" alt="Logo" class="h-10 w-auto object-contain drop-shadow-sm">
                <% } %>

                <div class="flex items-center gap-1">
                    <span class="text-2xl font-bold tracking-tighter transition-colors"
                          :class="(scrolled || mobileMenuOpen) ? 'text-gray-800' : 'text-gray-800'">
                        Official<span class="text-gold-500">game</span>.id
                    </span>
                    <div class="h-2 w-2 rounded-full bg-gold-500 group-hover:animate-ping"></div>
                </div>
            </a>
            
            <div class="hidden md:flex items-center space-x-8">
                <a href="/" class="font-medium hover:text-gold-500 transition relative group">
                    Beranda
                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gold-500 transition-all group-hover:w-full"></span>
                </a>
                <a href="/#database" class="font-medium hover:text-gold-500 transition relative group">
                    Database
                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gold-500 transition-all group-hover:w-full"></span>
                </a>
            </div>

            <button @click="mobileMenuOpen = !mobileMenuOpen" 
                    class="md:hidden relative z-50 p-2 text-gray-800 focus:outline-none">
                <div class="w-6 flex flex-col items-end gap-1.5">
                    <span class="block h-0.5 w-full bg-current transform transition duration-300" :class="mobileMenuOpen ? 'rotate-45 translate-y-2' : ''"></span>
                    <span class="block h-0.5 w-full bg-current transition duration-300" :class="mobileMenuOpen ? 'opacity-0' : ''"></span>
                    <span class="block h-0.5 w-full bg-current transform transition duration-300" :class="mobileMenuOpen ? '-rotate-45 -translate-y-2' : ''"></span>
                </div>
            </button>
        </div>

        <div x-show="mobileMenuOpen" 
             x-collapse 
             @click.away="mobileMenuOpen = false"
             class="md:hidden mt-4 pb-4 border-t border-gray-100">
            <div class="flex flex-col space-y-4 pt-4 text-center">
                <a href="/" class="text-lg font-medium text-gray-800 hover:text-gold-500">Beranda</a>
                <a href="/#database" class="text-lg font-medium text-gray-800 hover:text-gold-500">Database</a>
            </div>
        </div>
    </div>
</nav>