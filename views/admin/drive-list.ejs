<%- include('../layouts/admin-header', { currentPath: '/database' }) %>
<%- include('components/sync-overlay') %>

<div x-data="{ 
    deleteModalOpen: false, 
    addModalOpen: false,
    deleteAction: '', 
    deleteName: '',
    confirmDelete(url, name) {
        this.deleteAction = url;
        this.deleteName = name;
        this.deleteModalOpen = true;
    }
}">

    <header class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <a href="/admin/database" class="text-xs text-slate-400 font-bold uppercase tracking-wider hover:text-indigo-600 mb-2 block">← Kembali ke Hub Database</a>
            <h2 class="text-3xl font-bold text-slate-800">Daftar Database</h2>
            <p class="text-slate-500 mt-1">Kelola folder Google Drive Anda di sini.</p>
        </div>
        <div>
            <button @click="addModalOpen = true" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl font-bold flex items-center gap-2 shadow-lg shadow-indigo-200 transition transform hover:-translate-y-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Tambah Database
            </button>
        </div>
    </header>

    <% if(drives.length === 0) { %>
        <div class="text-center py-16 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
            <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm text-4xl">📂</div>
            <h3 class="text-xl font-bold text-slate-700">Belum ada Database</h3>
            <p class="text-slate-500 mb-6">Silakan tambahkan folder Google Drive pertama Anda.</p>
            <button @click="addModalOpen = true" class="text-indigo-600 font-bold hover:underline">Tambah Sekarang</button>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% drives.forEach(drive => { %>
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 overflow-hidden group"
                     x-data="driveCard('<%= drive._id %>')">
                     
                     <div class="p-6 relative">
                        <div x-show="syncing" x-transition class="absolute inset-0 bg-white/95 z-10 flex flex-col justify-center items-center p-6 text-center">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mb-3"></div>
                            <p class="text-sm font-bold text-slate-700" x-text="statusMsg">Menghubungkan...</p>
                            <p class="text-xs text-slate-400 mt-1 font-mono" x-text="detailMsg">...</p>
                        </div>

                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600">
                               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                            </div>
                            
                            <div class="relative" x-data="{open: false}">
                                <button @click="open = !open" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path></svg>
                                </button>
                                <div x-show="open" @click.away="open = false" class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-slate-100 py-2 z-20 overflow-hidden" x-transition>
                                    <a href="/admin/drive-logs?driveId=<%= drive.rootFolderId %>" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 font-medium">Detail & Log</a>
                                    <div class="border-t border-slate-50"></div>
                                    <button @click="confirmDelete('/admin/drives/<%= drive._id %>?_method=DELETE', '<%= drive.name %>'); open = false" 
                                            class="w-full text-left px-4 py-3 text-red-600 hover:bg-red-50 text-sm font-bold flex items-center gap-2">
                                        Hapus Database
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <h3 class="text-xl font-bold text-slate-800 mb-1 truncate" title="<%= drive.name %>"><%= drive.name %></h3>
                        <p class="text-xs text-slate-400 font-mono bg-slate-100 inline-block px-2 py-1 rounded truncate w-full mb-4">
                            Files: <%= drive.totalFiles || 0 %>
                        </p>

                        <button @click="startSync" :disabled="syncing" class="w-full flex items-center justify-center space-x-2 bg-slate-900 text-white py-2.5 rounded-xl hover:bg-indigo-600 transition shadow-lg shadow-slate-900/20 disabled:opacity-50 disabled:cursor-not-allowed font-bold text-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            <span>Sinkronisasi</span>
                        </button>
                        
                        <div class="mt-3 text-center">
                             <span class="text-[10px] text-slate-400 uppercase tracking-widest font-medium">
                                <%= drive.lastSync ? 'Update: ' + new Date(drive.lastSync).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : 'Belum Sync' %>
                            </span>
                        </div>
                     </div>
                </div>
            <% }) %>
        </div>
    <% } %>
    
    <div x-show="addModalOpen" x-cloak class="fixed inset-0 z-[99] flex items-center justify-center bg-black/60 backdrop-blur-sm"
         x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
        
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg p-8 relative transform transition-all scale-100" @click.away="addModalOpen = false">
            <button @click="addModalOpen = false" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <h3 class="text-2xl font-extrabold text-slate-800 mb-6">Tambah Database</h3>
            
            <form action="/admin/drives" method="POST" class="space-y-5">
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">Nama Produk / Database</label>
                    <input type="text" name="name" required placeholder="Contoh: Database Film 2024" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">ID Folder Google Drive</label>
                    <input type="text" name="rootFolderId" required placeholder="Paste ID Folder di sini..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none font-mono text-sm">
                    <p class="text-xs text-slate-400 mt-1">Ambil dari URL folder Google Drive Anda.</p>
                </div>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">URL Gambar Cover</label>
                    <input type="text" name="imageUrl" placeholder="https://..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                
                <div class="pt-4">
                    <button type="submit" class="w-full bg-indigo-600 text-white py-3.5 rounded-xl font-bold text-lg hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition">
                        Simpan Database
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div x-show="deleteModalOpen" x-cloak class="fixed inset-0 z-[99] flex items-center justify-center bg-black/60 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6" @click.away="deleteModalOpen = false">
            <div class="text-center">
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">Hapus Database?</h3>
                <p class="text-slate-500 text-sm mb-6">Anda akan menghapus <span class="font-bold text-slate-800" x-text="deleteName"></span>. Data tidak bisa dikembalikan.</p>
                <div class="flex gap-3">
                    <button @click="deleteModalOpen = false" class="flex-1 py-2.5 bg-white border border-slate-300 rounded-xl text-slate-700 font-bold">Batal</button>
                    <form :action="deleteAction" method="POST" class="flex-1">
                        <button type="submit" class="w-full py-2.5 bg-red-600 text-white rounded-xl font-bold">Ya, Hapus</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('driveCard', (driveId) => ({
            syncing: false,
            statusMsg: 'Menunggu...',
            detailMsg: '',

            async startSync() {
                if(!confirm('Mulai sinkronisasi data?')) return;
                this.syncing = true;
                this.statusMsg = 'Sedang Memproses...';
                
                try {
                    const response = await fetch(`/admin/sync/${driveId}`, { method: 'POST' });
                    const data = await response.json();

                    if (data.status === 'success') {
                        this.statusMsg = '✅ Selesai!';
                        setTimeout(() => { window.location.reload(); }, 1000);
                    } else {
                        throw new Error(data.message);
                    }
                } catch (error) {
                    alert('Gagal: ' + error.message);
                    this.syncing = false;
                }
            }
        }));
    });
</script>

<%- include('../layouts/admin-footer') %>