<div class="p-6 space-y-6" x-data="{ activeTab: '<%= typeof activeTab !== 'undefined' ? activeTab : 'members' %>', showLogModal: false, selectedLog: null }">
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-2">
        <div class="flex items-center gap-4 w-full md:w-auto">
            <a href="/admin/members" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition shadow-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <div class="overflow-hidden">
                <h2 class="text-2xl font-bold text-gray-800 truncate max-w-md" title="<%= selectedGroup %>"><%= selectedGroup %></h2>
                <p class="text-gray-500 text-sm flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                    Update Terakhir: <%= new Date(stats.lastSync).toLocaleString('id-ID') %>
                </p>
            </div>
        </div>
        
        <form action="/admin/members/sync-direct" method="POST" onsubmit="return confirm('Update data terbaru dari Google untuk grup ini?')" class="w-full md:w-auto">
            <input type="hidden" name="groupEmail" value="<%= selectedGroup %>">
            <button type="submit" class="w-full md:w-auto bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-xl hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 flex items-center justify-center gap-2 transition shadow-sm font-bold text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                Sync Sekarang
            </button>
        </form>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-indigo-100 shadow-sm">
            <div class="text-xs font-bold text-indigo-400 uppercase tracking-wider mb-1">Total Anggota</div>
            <div class="text-3xl font-extrabold text-gray-900"><%= stats.total %></div>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-orange-100 shadow-sm">
            <div class="text-xs font-bold text-orange-400 uppercase tracking-wider mb-1">Owner / Pemilik</div>
            <div class="text-3xl font-extrabold text-gray-900"><%= stats.owner %></div>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-blue-100 shadow-sm">
            <div class="text-xs font-bold text-blue-400 uppercase tracking-wider mb-1">Manager</div>
            <div class="text-3xl font-extrabold text-gray-900"><%= stats.manager %></div>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-red-100 shadow-sm">
            <div class="text-xs font-bold text-red-400 uppercase tracking-wider mb-1">Terpental / Keluar</div>
            <div class="text-3xl font-extrabold text-gray-900"><%= stats.terpental %></div>
        </div>
    </div>

    <div class="flex space-x-1 bg-slate-100 p-1 rounded-xl w-fit shadow-inner overflow-x-auto">
        <button @click="activeTab = 'members'" 
                class="px-5 py-2 rounded-lg text-sm font-bold transition whitespace-nowrap"
                :class="activeTab === 'members' ? 'bg-white text-indigo-600 shadow-sm' : 'text-gray-500 hover:text-gray-700'">
            Daftar Anggota
        </button>
        <button @click="activeTab = 'history'" 
                class="px-5 py-2 rounded-lg text-sm font-bold transition whitespace-nowrap"
                :class="activeTab === 'history' ? 'bg-white text-indigo-600 shadow-sm' : 'text-gray-500 hover:text-gray-700'">
            Riwayat Aktivitas
        </button>
    </div>

    <div x-show="activeTab === 'members'" class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-gray-50 flex flex-col xl:flex-row justify-between items-center gap-4">
            <div class="flex p-1 bg-white rounded-lg border border-gray-200 shadow-sm w-full xl:w-auto overflow-x-auto no-scrollbar">
                <a href="?group=<%= selectedGroup %>&sort=<%= sortParam %>&logPage=<%= currentLogPage %>" class="px-4 py-1.5 rounded-md text-sm font-medium transition whitespace-nowrap <%= !roleFilter ? 'bg-gray-100 text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-700' %>">Semua</a>
                <a href="?group=<%= selectedGroup %>&role=owner&sort=<%= sortParam %>&logPage=<%= currentLogPage %>" class="px-4 py-1.5 rounded-md text-sm font-medium transition whitespace-nowrap <%= roleFilter === 'owner' ? 'bg-orange-50 text-orange-700 shadow-sm' : 'text-gray-500 hover:text-gray-700' %>">Owner</a>
                <a href="?group=<%= selectedGroup %>&role=manager&sort=<%= sortParam %>&logPage=<%= currentLogPage %>" class="px-4 py-1.5 rounded-md text-sm font-medium transition whitespace-nowrap <%= roleFilter === 'manager' ? 'bg-blue-50 text-blue-700 shadow-sm' : 'text-gray-500 hover:text-gray-700' %>">Manager</a>
                <a href="?group=<%= selectedGroup %>&role=member&sort=<%= sortParam %>&logPage=<%= currentLogPage %>" class="px-4 py-1.5 rounded-md text-sm font-medium transition whitespace-nowrap <%= roleFilter === 'member' ? 'bg-green-50 text-green-700 shadow-sm' : 'text-gray-500 hover:text-gray-700' %>">Member</a>
            </div>

            <form action="/admin/members" method="GET" class="flex gap-2 w-full xl:w-auto">
                <input type="hidden" name="group" value="<%= selectedGroup %>">
                <input type="hidden" name="logPage" value="<%= currentLogPage %>">
                <% if(roleFilter) { %><input type="hidden" name="role" value="<%= roleFilter %>"><% } %>
                
                <select name="sort" onchange="this.form.submit()" class="bg-white border border-gray-200 text-gray-700 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 outline-none cursor-pointer font-medium">
                    <option value="default" <%= sortParam === 'default' ? 'selected' : '' %>>Urutkan: Default</option>
                    <option value="newest" <%= sortParam === 'newest' ? 'selected' : '' %>>Terbaru Gabung</option>
                    <option value="oldest" <%= sortParam === 'oldest' ? 'selected' : '' %>>Terlama Gabung</option>
                    <option value="a-z" <%= sortParam === 'a-z' ? 'selected' : '' %>>Nama (A-Z)</option>
                    <option value="z-a" <%= sortParam === 'z-a' ? 'selected' : '' %>>Nama (Z-A)</option>
                </select>

                <div class="relative flex-grow">
                    <input type="text" name="q" value="<%= search %>" placeholder="Cari nama / email..." class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition shadow-sm">
                    <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
            </form>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-white border-b border-gray-100 text-xs uppercase text-gray-400 font-bold tracking-wider">
                        <th class="px-6 py-4 w-10">#</th>
                        <th class="px-6 py-4">Profil Anggota</th>
                        <th class="px-6 py-4">Role & Status</th>
                        <th class="px-6 py-4 text-right">Tanggal Gabung</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    <% if (members.length === 0) { %> <tr><td colspan="4" class="text-center py-12 text-gray-400 italic">Data tidak ditemukan.</td></tr> <% } %>
                    <% members.forEach((m, i) => { %>
                        <tr class="hover:bg-gray-50/80 transition group">
                            <td class="px-6 py-4 text-xs text-gray-400 font-mono"><%= (currentPage - 1) * 50 + i + 1 %></td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg font-bold uppercase border border-indigo-100"><%= m.email.charAt(0) %></div>
                                    <div><div class="font-bold text-gray-900 text-sm"><%= m.name || 'Tanpa Nama' %></div><div class="text-xs text-gray-500 font-mono"><%= m.email %></div></div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col items-start gap-1.5">
                                    <span class="inline-flex px-2.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= m.role.includes('owner') ? 'bg-orange-50 text-orange-700 border-orange-200' : (m.role.includes('manager') ? 'bg-blue-50 text-blue-700 border-blue-200' : 'bg-gray-50 text-gray-600 border-gray-200') %>"><%= m.role %></span>
                                    <span class="text-xs flex items-center gap-1 font-medium <%= m.status === 'active' ? 'text-green-600' : 'text-red-600' %>">
                                        <span class="w-1.5 h-1.5 rounded-full <%= m.status === 'active' ? 'bg-green-500' : 'bg-red-500' %>"></span>
                                        <%= m.status === 'active' ? 'AKTIF' : 'TERPENTAL' %>
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right text-sm text-gray-500">
                                <% if (m.joinDate) { %>
                                    <div class="font-bold text-gray-700"><%= new Date(m.joinDate).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></div>
                                    <div class="text-xs text-gray-400"><%= new Date(m.joinDate).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) %></div>
                                <% } else if (m.lastSync) { %>
                                    <div class="text-xs text-gray-400 italic" title="Estimasi dari sync pertama">(Est) <%= new Date(m.lastSync).toLocaleDateString('id-ID') %></div>
                                <% } else { %> <span class="text-gray-300">-</span> <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        
        <% if (totalPages > 1) { %>
            <div class="flex items-center justify-between p-4 border-t border-gray-100 bg-gray-50">
                <div class="text-xs text-gray-500">Menampilkan <%= members.length %> dari <%= totalMembers %> data</div>
                <div class="flex gap-2">
                    <% if (currentPage > 1) { %> <a href="?group=<%= selectedGroup %>&role=<%= roleFilter %>&sort=<%= sortParam %>&q=<%= search %>&logPage=<%= currentLogPage %>&page=<%= currentPage - 1 %>" class="px-3 py-1 bg-white border border-gray-200 rounded text-sm text-gray-600 hover:bg-gray-100">Prev</a> <% } %>
                    <% if (currentPage < totalPages) { %> <a href="?group=<%= selectedGroup %>&role=<%= roleFilter %>&sort=<%= sortParam %>&q=<%= search %>&logPage=<%= currentLogPage %>&page=<%= currentPage + 1 %>" class="px-3 py-1 bg-white border border-gray-200 rounded text-sm text-gray-600 hover:bg-gray-100">Next</a> <% } %>
                </div>
            </div>
        <% } %>
    </div>

    <div x-show="activeTab === 'history'" x-cloak class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-gray-50 flex flex-col md:flex-row justify-between items-center gap-4">
            
            <div class="flex items-center gap-2 w-full md:w-auto">
                <form action="/admin/members" method="GET" class="flex gap-2">
                    <input type="hidden" name="group" value="<%= selectedGroup %>">
                    <input type="hidden" name="page" value="<%= currentPage %>">
                    <input type="hidden" name="activeTab" value="history">
                    
                    <select name="logSort" onchange="this.form.submit()" class="bg-white border border-gray-200 text-gray-700 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 outline-none cursor-pointer font-medium">
                        <option value="newest" <%= logSortParam === 'newest' ? 'selected' : '' %>>Waktu: Terbaru</option>
                        <option value="oldest" <%= logSortParam === 'oldest' ? 'selected' : '' %>>Waktu: Terlama</option>
                        <option value="action-a-z" <%= logSortParam === 'action-a-z' ? 'selected' : '' %>>Aksi (A-Z)</option>
                        <option value="action-z-a" <%= logSortParam === 'action-z-a' ? 'selected' : '' %>>Aksi (Z-A)</option>
                    </select>
                </form>
            </div>

            <a href="/admin/members/export-logs?group=<%= encodeURIComponent(selectedGroup) %>" class="flex items-center gap-2 text-xs font-bold text-green-700 bg-green-100 px-3 py-2 rounded-lg hover:bg-green-200 transition shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Download CSV
            </a>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-white border-b border-gray-100 text-xs uppercase text-gray-400 font-bold tracking-wider">
                        <th class="px-6 py-4">Waktu</th>
                        <th class="px-6 py-4">Aksi</th>
                        <th class="px-6 py-4">Anggota</th>
                        <th class="px-6 py-4">Keterangan</th>
                        <th class="px-6 py-4">Eksekutor</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
                        <% logs.forEach(log => { %>
                            <tr class="hover:bg-indigo-50/50 transition cursor-pointer"
                                @click="showLogModal = true; selectedLog = {
                                    time: '<%= new Date(log.timestamp).toLocaleString('id-ID') %>',
                                    action: '<%= log.action %>',
                                    targetName: '<%= log.targetName %>',
                                    targetEmail: '<%= log.targetEmail %>',
                                    executor: '<%= log.performedBy %>',
                                    detail: '<%= log.details %>'
                                }">
                                <td class="px-6 py-4 text-xs text-gray-500 font-mono whitespace-nowrap">
                                    <%= new Date(log.timestamp).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour:'2-digit', minute:'2-digit' }) %>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (log.action === 'JOIN') { %> <span class="text-green-600 font-bold text-[10px] bg-green-50 px-2 py-1 rounded border border-green-100">MASUK</span> <% } else if (log.action === 'LEFT') { %> <span class="text-red-600 font-bold text-[10px] bg-red-50 px-2 py-1 rounded border border-red-100">KELUAR</span> <% } else { %> <span class="text-blue-600 font-bold text-[10px] bg-blue-50 px-2 py-1 rounded border border-blue-100">UPDATE</span> <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm font-bold text-gray-900"><%= log.targetName || 'Unknown' %></div>
                                    <div class="text-xs text-gray-500 font-mono"><%= log.targetEmail %></div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-600 truncate max-w-[200px]"><%= log.details %></td>
                                <td class="px-6 py-4 text-xs text-gray-500"><%= log.performedBy ? log.performedBy.split('@')[0] : 'System' %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5" class="text-center py-12 text-gray-400 italic">Belum ada riwayat aktivitas.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (totalLogPages > 1) { %>
            <div class="flex items-center justify-between p-4 border-t border-gray-100 bg-gray-50">
                <div class="text-xs text-gray-500">Halaman <%= currentLogPage %> dari <%= totalLogPages %></div>
                <div class="flex gap-2">
                    <% if (currentLogPage > 1) { %> 
                        <a href="?group=<%= selectedGroup %>&role=<%= roleFilter %>&sort=<%= sortParam %>&q=<%= search %>&activeTab=history&logPage=<%= currentLogPage - 1 %>&page=<%= currentPage %>&logSort=<%= logSortParam %>" class="px-3 py-1 bg-white border rounded text-xs hover:bg-gray-100">Prev</a> 
                    <% } %>
                    <% if (currentLogPage < totalLogPages) { %> 
                        <a href="?group=<%= selectedGroup %>&role=<%= roleFilter %>&sort=<%= sortParam %>&q=<%= search %>&activeTab=history&logPage=<%= currentLogPage + 1 %>&page=<%= currentPage %>&logSort=<%= logSortParam %>" class="px-3 py-1 bg-white border rounded text-xs hover:bg-gray-100">Next</a> 
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>

    <div x-show="showLogModal" x-cloak class="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-sm" 
         x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
        
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 relative transform transition-all" @click.away="showLogModal = false">
            <button @click="showLogModal = false" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">✕</button>
            
            <h3 class="text-lg font-bold text-slate-800 mb-4 border-b pb-2">Detail Riwayat</h3>
            
            <div class="space-y-4 text-sm">
                <div class="flex gap-4">
                    <div class="flex-1">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">Waktu</label>
                        <div class="font-mono text-slate-700 bg-slate-50 px-2 py-1 rounded border" x-text="selectedLog?.time"></div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">Aksi</label>
                        <span class="px-2 py-1 rounded text-xs font-bold bg-slate-100 text-slate-700" x-text="selectedLog?.action"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">Anggota Terkait</label>
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <div class="font-bold text-slate-800" x-text="selectedLog?.targetName || 'Tidak Diketahui'"></div>
                        <div class="text-xs text-slate-500 font-mono" x-text="selectedLog?.targetEmail"></div>
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">Eksekutor (Oleh Siapa?)</label>
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center text-xs font-bold">
                            <span x-text="selectedLog?.executor?.charAt(0).toUpperCase()"></span>
                        </div>
                        <span class="text-slate-700 font-medium" x-text="selectedLog?.executor"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">Keterangan Lengkap</label>
                    <div class="bg-yellow-50 text-yellow-800 p-3 rounded-lg border border-yellow-100 text-xs leading-relaxed" x-text="selectedLog?.detail"></div>
                </div>
            </div>

            <div class="mt-6 text-right">
                <button @click="showLogModal = false" class="bg-slate-900 text-white px-4 py-2 rounded-lg text-sm hover:bg-slate-800 transition">Tutup</button>
            </div>
        </div>
    </div>

</div>