<div x-data="{ 
    addModalOpen: false,
    syncing: false
}">

    <div class="flex flex-col md:flex-row justify-between items-center px-8 pt-8 mb-6 gap-4">
        <div>
            <h3 class="text-lg font-bold text-slate-800">Daftar Grup Terhubung</h3>
            <p class="text-xs text-slate-500 mt-1">Pilih grup untuk melihat detail anggota.</p>
        </div>
        
        <button @click="addModalOpen = true" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold text-sm flex items-center gap-2 shadow-lg shadow-indigo-200 transition transform hover:-translate-y-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Tambah / Sync Grup
        </button>
    </div>
    
    <div class="px-8 pb-8">
        <% if (groups.length === 0) { %>
            <div class="text-center py-16 bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200">
                <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm text-3xl">👥</div>
                <h3 class="text-lg font-bold text-slate-700">Belum ada Grup</h3>
                <p class="text-slate-500 mb-6 text-sm">Sinkronisasi dengan Google Group Workspace Anda untuk memulai.</p>
                <button @click="addModalOpen = true" class="text-indigo-600 font-bold hover:underline text-sm">Tambah Sekarang</button>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% groups.forEach(g => { %>
                    <a href="/admin/members?group=<%= encodeURIComponent(g._id) %>" class="group relative bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:border-indigo-300 transition-all duration-300 overflow-hidden">
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            <svg class="w-24 h-24 text-indigo-600" fill="currentColor" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </div>

                        <div class="relative z-10">
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-10 h-10 bg-indigo-50 rounded-lg flex items-center justify-center text-lg border border-indigo-100 group-hover:scale-110 transition-transform text-indigo-600">
                                    G
                                </div>
                                <span class="bg-green-50 text-green-700 text-[10px] font-bold px-2 py-1 rounded-md border border-green-100 flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                                    <%= g.activeCount %> Aktif
                                </span>
                            </div>
                            
                            <h4 class="text-sm font-bold text-slate-800 truncate mb-1" title="<%= g._id %>"><%= g._id %></h4>
                            <p class="text-xs text-slate-400 mb-6">Total: <%= g.totalMembers %> Anggota</p>
                            
                            <div class="pt-4 border-t border-slate-50 flex items-center justify-between">
                                <div class="text-[10px] text-slate-400">
                                    Sync: <%= g.lastSync ? new Date(g.lastSync).toLocaleDateString('id-ID') : '-' %>
                                </div>
                                <span class="text-xs font-bold text-indigo-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                                    Detail <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </span>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    </div>

    <div x-show="addModalOpen" x-cloak class="fixed inset-0 z-[99] flex items-center justify-center bg-black/60 backdrop-blur-sm"
         x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
        
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 relative transform transition-all scale-100" @click.away="addModalOpen = false">
            <button @click="addModalOpen = false" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">✕</button>
            
            <h3 class="text-xl font-bold text-slate-800 mb-2">Sinkronisasi Grup</h3>
            <p class="text-sm text-slate-500 mb-6">Masukkan email Google Group (Workspace) untuk mengambil data anggota terbaru.</p>
            
            <form action="/admin/members/sync-direct" method="POST" @submit="syncing = true">
                <div class="mb-6">
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Email Grup</label>
                    <input type="email" name="groupEmail" required placeholder="contoh: member@domainanda.com" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none font-mono text-sm">
                    <p class="text-[10px] text-orange-500 mt-2 flex items-start gap-1">
                        <svg class="w-3 h-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        Pastikan email Admin Website ini sudah menjadi Owner/Manager di grup tersebut.
                    </p>
                </div>
                
                <button type="submit" :disabled="syncing" class="w-full bg-indigo-600 text-white py-3 rounded-xl font-bold shadow-lg shadow-indigo-200 hover:bg-indigo-700 transition flex justify-center items-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed">
                    <span x-show="!syncing">Mulai Sinkronisasi</span>
                    <span x-show="syncing" class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        Memproses...
                    </span>
                </button>
            </form>
        </div>
    </div>
</div>