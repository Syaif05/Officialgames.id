<div class="flex items-center justify-between mb-4" x-data="{ menuOpen: false, editOpen: false }">
    
    <div class="w-14 h-14 rounded-xl overflow-hidden border border-slate-200 shadow-sm shrink-0 bg-gray-100">
        <img src="<%= drive.imageUrl %>" 
             class="w-full h-full object-cover" 
             alt="Cover"
             onerror="this.src='https://placehold.co/100?text=No+Img'">
    </div>
    
    <div class="relative">
        <button @click="menuOpen = !menuOpen" class="text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-100 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path></svg>
        </button>
        
        <div x-show="menuOpen" 
             @click.away="menuOpen = false" 
             class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl border border-slate-100 py-2 z-20" 
             x-transition>
            
            <button @click="editOpen = true; menuOpen = false" class="w-full text-left px-4 py-2 text-slate-700 hover:bg-slate-50 text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Edit Database
            </button>

            <form action="/admin/drives/<%= drive._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Yakin hapus? Data folder <%= drive.name %> di database akan ikut terhapus.')">
                <button class="w-full text-left px-4 py-2 text-red-600 hover:bg-red-50 text-sm flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    Hapus Database
                </button>
            </form>
        </div>
    </div>

    <div x-show="editOpen" 
         x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm" 
         x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
         
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden m-4" @click.away="editOpen = false">
            <div class="bg-indigo-600 px-6 py-4 flex justify-between items-center">
                <h3 class="text-white font-bold text-lg">Edit Database</h3>
                <button @click="editOpen = false" class="text-indigo-200 hover:text-white text-2xl leading-none">&times;</button>
            </div>
            
            <form action="/admin/drives/<%= drive._id %>/update" method="POST" class="p-6">
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Nama Database</label>
                    <input type="text" name="name" value="<%= drive.name %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">URL Gambar (Cover)</label>
                    <input type="text" name="imageUrl" value="<%= drive.imageUrl %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="https://...">
                    <p class="text-xs text-gray-400 mt-1">Masukkan link gambar baru (JPG/PNG).</p>
                </div>
                
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" @click="editOpen = false" class="px-4 py-2 text-gray-500 hover:bg-gray-100 rounded-lg font-medium">Batal</button>
                    <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium shadow-lg">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

</div>

<h3 class="text-xl font-bold text-slate-800 mb-1 truncate"><%= drive.name %></h3>
<p class="text-xs text-slate-400 font-mono bg-slate-50 inline-block px-2 py-1 rounded truncate w-full mb-4 border border-slate-100">
    Collection: files_<%= drive.slug.replace(/-/g, '_') %>
</p>

<div class="flex items-center justify-between text-sm text-slate-500 mb-6">
    <span>Total File: <b class="text-slate-700"><%= drive.totalFiles || 0 %></b></span>
</div>

<button @click="startDirectSync('<%= drive._id %>')" 
        :disabled="syncing" 
        class="w-full flex items-center justify-center space-x-2 bg-slate-900 text-white py-2.5 rounded-xl hover:bg-indigo-600 transition shadow-lg shadow-slate-900/20 disabled:opacity-50 disabled:cursor-not-allowed group">
    
    <svg x-show="syncing" class="animate-spin -ml-1 mr-3 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>

    <svg x-show="!syncing" class="w-4 h-4 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
    
    <span x-text="syncing ? 'Memproses...' : 'Sync Cloud'"></span>
</button>

<div class="mt-3 text-center">
     <span class="text-[10px] text-slate-400 uppercase tracking-widest">
        <%= drive.lastSync ? 'Update: ' + drive.lastSync.toLocaleTimeString() : 'Belum Sync' %>
    </span>
</div>