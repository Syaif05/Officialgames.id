<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden" x-data="{ showMemberModal: false, selectedMember: null }">
    
    <div class="p-5 border-b border-slate-100 bg-slate-50 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex flex-wrap gap-2 w-full md:w-auto">
            <a href="?driveId=<%= filterDrive %>&tab=members" class="px-3 py-1.5 text-xs font-bold rounded-lg border <%= !filterRole ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-600 hover:bg-slate-100' %>">Semua</a>
            <a href="?driveId=<%= filterDrive %>&tab=members&role=organizer" class="px-3 py-1.5 text-xs font-bold rounded-lg border <%= filterRole === 'organizer' ? 'bg-purple-600 text-white border-purple-600' : 'bg-white text-slate-600 hover:text-purple-600' %>">Pemilik (Organizer)</a>
            <a href="?driveId=<%= filterDrive %>&tab=members&role=fileOrganizer" class="px-3 py-1.5 text-xs font-bold rounded-lg border <%= filterRole === 'fileOrganizer' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-600 hover:text-blue-600' %>">Pengelola</a>
            <a href="?driveId=<%= filterDrive %>&tab=members&role=reader" class="px-3 py-1.5 text-xs font-bold rounded-lg border <%= filterRole === 'reader' ? 'bg-green-600 text-white border-green-600' : 'bg-white text-slate-600 hover:text-green-600' %>">Pembaca</a>
        </div>

        <div class="flex gap-2 w-full md:w-auto">
            <form action="/admin/drive-logs" method="GET" class="relative flex-grow">
                <input type="hidden" name="driveId" value="<%= filterDrive %>">
                <input type="hidden" name="tab" value="members">
                <% if(filterRole) { %><input type="hidden" name="role" value="<%= filterRole %>"><% } %>
                
                <input type="text" name="searchMember" value="<%= searchMember %>" placeholder="Cari nama / email..." class="w-full pl-9 pr-4 py-2 rounded-lg border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </form>
            
            <form action="/admin/drive-logs/sync-members" method="POST">
                <input type="hidden" name="driveId" value="<%= filterDrive %>">
                <button type="submit" class="bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 px-3 py-2 rounded-lg font-bold transition shadow-sm h-full" title="Scan Ulang">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                </button>
            </form>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead class="bg-white border-b border-slate-100 text-xs uppercase text-slate-400 font-bold">
                <tr><th class="px-6 py-4">Anggota</th><th class="px-6 py-4">Role</th><th class="px-6 py-4">Tipe</th><th class="px-6 py-4 text-right">Aksi</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-50 text-sm text-slate-600">
                <% if(members.length === 0) { %> <tr><td colspan="4" class="text-center py-12 italic text-slate-400">Tidak ada data.</td></tr> <% } %>
                
                <% members.forEach(m => { 
                    let roleLabel = 'Anggota';
                    let roleColor = 'bg-slate-100 text-slate-600';
                    if(m.role === 'organizer') { roleLabel = 'Pemilik'; roleColor = 'bg-purple-100 text-purple-700'; }
                    if(m.role === 'fileOrganizer') { roleLabel = 'Pengelola'; roleColor = 'bg-blue-100 text-blue-700'; }
                    if(m.role === 'writer') { roleLabel = 'Editor'; roleColor = 'bg-orange-100 text-orange-700'; }
                    if(m.role === 'reader') { roleLabel = 'Pembaca'; roleColor = 'bg-green-100 text-green-700'; }
                %>
                    <tr class="hover:bg-slate-50/50 transition group cursor-pointer" 
                        @click="showMemberModal = true; selectedMember = {
                            name: '<%= m.displayName %>', email: '<%= m.email %>', role: '<%= roleLabel %>', type: '<%= m.type %>',
                            id: '<%= m.permissionId %>', photo: '<%= m.photoLink %>', sync: '<%= new Date(m.lastSync).toLocaleString() %>'
                        }">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <% if(m.photoLink) { %> <img src="<%= m.photoLink %>" class="w-9 h-9 rounded-full border border-slate-200 object-cover"> <% } else { %> <div class="w-9 h-9 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 font-bold text-xs"><%= m.displayName ? m.displayName.charAt(0).toUpperCase() : '?' %></div> <% } %>
                                <div><div class="font-bold text-slate-800"><%= m.displayName %></div><div class="text-xs text-slate-400 font-mono"><%= m.email %></div></div>
                            </div>
                        </td>
                        <td class="px-6 py-4"><span class="uppercase text-[10px] font-bold px-2 py-1 rounded border border-white shadow-sm <%= roleColor %>"><%= roleLabel %></span></td>
                        <td class="px-6 py-4 text-xs uppercase"><%= m.type %></td>
                        <td class="px-6 py-4 text-right"><button class="text-indigo-600 hover:text-indigo-800 text-xs font-bold group-hover:underline">Detail</button></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <div x-show="showMemberModal" x-cloak class="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-sm"
         x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 relative transform transition-all" @click.away="showMemberModal = false">
            <button @click="showMemberModal = false" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">✕</button>
            <div class="text-center mt-4">
                <img :src="selectedMember?.photo || 'https://via.placeholder.com/100'" class="w-20 h-20 rounded-full mx-auto border-4 border-slate-100 shadow-sm mb-4 object-cover">
                <h3 class="text-xl font-bold text-slate-800" x-text="selectedMember?.name"></h3>
                <p class="text-sm text-slate-500 font-mono" x-text="selectedMember?.email"></p>
                <div class="mt-4 inline-flex px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-600 border border-indigo-100" x-text="selectedMember?.role"></div>
            </div>
            <div class="mt-6 space-y-3 border-t border-slate-100 pt-4 text-sm">
                <div class="flex justify-between"><span class="text-slate-500">Tipe Akun:</span> <span class="font-medium uppercase" x-text="selectedMember?.type"></span></div>
                <div class="flex justify-between"><span class="text-slate-500">ID Izin:</span> <span class="font-mono text-xs" x-text="selectedMember?.id"></span></div>
                <div class="flex justify-between"><span class="text-slate-500">Terakhir Sync:</span> <span class="font-medium" x-text="selectedMember?.sync"></span></div>
            </div>
            <button @click="showMemberModal = false" class="w-full mt-6 bg-slate-900 text-white py-2 rounded-lg text-sm hover:bg-slate-800">Tutup</button>
        </div>
    </div>
</div>