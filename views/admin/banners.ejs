<%- include('../layouts/admin-header', { currentPath: '/banners' }) %>

<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="/admin/system" class="text-xs text-slate-400 font-bold uppercase tracking-wider hover:text-indigo-600 mb-2 block">← Kembali ke Hub System</a>
            <h2 class="text-3xl font-extrabold text-slate-800">Banner Promosi</h2>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit">
            <h3 class="font-bold text-slate-800 mb-4">Tambah Banner Baru</h3>
            <form action="/admin/banners" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Judul Banner</label>
                    <input type="text" name="title" placeholder="Contoh: Promo Spesial" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">URL Gambar (Wajib)</label>
                    <input type="text" name="imageUrl" required placeholder="https://..." class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Link Tujuan (Opsional)</label>
                    <input type="text" name="linkUrl" placeholder="https://..." class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                </div>
                <div class="flex gap-4">
                    <div class="flex-1">
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Urutan</label>
                        <input type="number" name="order" value="0" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                    </div>
                    <div class="flex items-end pb-2">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" name="isActive" checked class="w-4 h-4 text-orange-600 rounded focus:ring-orange-500">
                            <span class="text-sm font-medium text-slate-700">Aktif</span>
                        </label>
                    </div>
                </div>
                <button type="submit" class="w-full bg-orange-600 text-white py-2.5 rounded-xl font-bold text-sm hover:bg-orange-700 transition">
                    + Tambah Banner
                </button>
            </form>
        </div>

        <div class="lg:col-span-2 space-y-4">
            <% if(banners.length === 0) { %>
                <div class="text-center py-12 bg-slate-50 rounded-2xl border border-dashed border-slate-300">
                    <div class="text-4xl mb-2">🖼️</div>
                    <p class="text-slate-500">Belum ada banner yang dipasang.</p>
                </div>
            <% } %>

            <% banners.forEach(banner => { %>
                <div class="group bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row items-center gap-4 hover:shadow-md transition">
                    <div class="w-full sm:w-48 h-28 bg-slate-100 rounded-xl overflow-hidden relative">
                        <img src="<%= banner.imageUrl %>" class="w-full h-full object-cover">
                        <% if(!banner.isActive) { %>
                            <div class="absolute inset-0 bg-black/50 flex items-center justify-center text-white text-xs font-bold uppercase tracking-wider">Nonaktif</div>
                        <% } %>
                    </div>

                    <div class="flex-1 text-center sm:text-left">
                        <h4 class="font-bold text-slate-800"><%= banner.title || 'Tanpa Judul' %></h4>
                        <a href="<%= banner.imageUrl %>" target="_blank" class="text-xs text-indigo-500 hover:underline truncate block max-w-[200px] mx-auto sm:mx-0"><%= banner.imageUrl %></a>
                        <div class="mt-2 flex items-center justify-center sm:justify-start gap-2">
                            <span class="text-[10px] font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Urutan: <%= banner.order %></span>
                            <% if(banner.linkUrl) { %>
                                <span class="text-[10px] font-bold bg-green-50 text-green-600 px-2 py-0.5 rounded">Link Aktif</span>
                            <% } %>
                        </div>
                    </div>

                    <div class="flex flex-row sm:flex-col gap-2">
                        <form action="/admin/banners/<%= banner._id %>/toggle" method="POST">
                            <button type="submit" class="p-2 rounded-lg <%= banner.isActive ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500' %> hover:bg-opacity-80 transition" title="Toggle Status">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            </button>
                        </form>
                        <form action="/admin/banners/<%= banner._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Hapus banner ini?')">
                            <button type="submit" class="p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition" title="Hapus">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<%- include('../layouts/admin-footer') %>