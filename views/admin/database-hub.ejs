<%- include('../layouts/admin-header', { currentPath: '/database' }) %>

<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="/admin/dashboard" class="text-xs text-slate-400 font-bold uppercase tracking-wider hover:text-indigo-600 mb-2 block">← Kembali ke Dashboard</a>
            <h2 class="text-3xl font-extrabold text-slate-800">Manajemen Database</h2>
        </div>
        <div class="bg-indigo-50 text-indigo-700 px-4 py-2 rounded-xl text-sm font-bold shadow-sm">
            Total <%= totalDrives %> Databases
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        
        <a href="/admin/drives" class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg hover:border-indigo-300 transition-all duration-300">
            <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-slate-800 mb-1">Daftar Database</h3>
            <p class="text-xs text-slate-500 mb-4">Kelola, tambah, dan sinkronisasi folder Google Drive.</p>
            <div class="flex items-center text-xs font-bold text-indigo-600">
                Kelola Drives <svg class="w-3 h-3 ml-1 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
        </a>

        <a href="/admin/members" class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg hover:border-indigo-300 transition-all duration-300">
            <div class="w-10 h-10 rounded-lg bg-green-100 text-green-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-slate-800 mb-1">Kelola Anggota</h3>
            <p class="text-xs text-slate-500 mb-4">Monitoring akses user dan Google Group.</p>
            <div class="flex items-center text-xs font-bold text-green-600">
                Lihat <%= totalMembers %> Member <svg class="w-3 h-3 ml-1 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
        </a>

        <a href="/admin/activity-logs" class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg hover:border-indigo-300 transition-all duration-300">
            <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-slate-800 mb-1">Aktivitas Log</h3>
            <p class="text-xs text-slate-500 mb-4">Audit keamanan dan riwayat perubahan sistem.</p>
            <div class="flex items-center text-xs font-bold text-purple-600">
                Buka Audit Log <svg class="w-3 h-3 ml-1 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
        </a>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <h3 class="font-bold text-slate-700 text-sm">Database Terupdate</h3>
                <span class="text-xs text-slate-400">3 Terakhir</span>
            </div>
            <div class="divide-y divide-slate-50">
                <% recentDrives.forEach(drive => { %>
                    <div class="p-4 flex items-center gap-3">
                        <div class="w-8 h-8 rounded bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">📂</div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-sm font-bold text-slate-800 truncate"><%= drive.name %></h4>
                            <p class="text-[10px] text-slate-400">Sync: <%= drive.lastSync ? drive.lastSync.toLocaleDateString() : 'Belum' %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <h3 class="font-bold text-slate-700 text-sm">Member Baru Join</h3>
                <span class="text-xs text-slate-400">5 Terakhir</span>
            </div>
            <div class="divide-y divide-slate-50">
                <% recentMembers.forEach(member => { %>
                    <div class="p-4 flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-green-50 text-green-600 flex items-center justify-center text-xs font-bold"><%= member.name.charAt(0) %></div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-sm font-bold text-slate-800 truncate"><%= member.name %></h4>
                            <p class="text-[10px] text-slate-400"><%= member.email %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

    </div>

</div>

<%- include('../layouts/admin-footer') %>