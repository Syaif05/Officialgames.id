<%- include('../layouts/admin-header', { currentPath: '/system' }) %>

<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="/admin/dashboard" class="text-xs text-slate-400 font-bold uppercase tracking-wider hover:text-indigo-600 mb-2 block">← Kembali ke Dashboard</a>
            <h2 class="text-3xl font-extrabold text-slate-800">Pengaturan Sistem</h2>
        </div>
        <div class="bg-pink-50 text-pink-700 px-4 py-2 rounded-xl text-sm font-bold shadow-sm">
            <%= activeBannerCount %> Banner Aktif
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        
        <a href="/admin/settings" class="group bg-white p-8 rounded-3xl shadow-sm border border-slate-200 hover:shadow-xl hover:border-pink-300 transition-all duration-300">
            <div class="flex items-center gap-6 mb-6">
                <div class="w-16 h-16 rounded-2xl bg-pink-100 text-pink-600 flex items-center justify-center group-hover:scale-110 transition-transform shadow-sm">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-slate-800 mb-1">Konfigurasi Global</h3>
                    <p class="text-sm text-slate-500">Edit Judul, Deskripsi, dan Kontak.</p>
                </div>
            </div>
            
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-xs">
                <div class="flex justify-between mb-2">
                    <span class="text-slate-400 font-bold">Judul Situs</span>
                    <span class="text-slate-800 font-bold"><%= setting ? setting.siteTitle : 'Belum diset' %></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400 font-bold">Kontak WA</span>
                    <span class="text-slate-800"><%= setting ? setting.contactWa : '-' %></span>
                </div>
            </div>

            <div class="mt-6 flex items-center text-pink-600 font-bold text-sm group-hover:translate-x-2 transition-transform">
                Edit Pengaturan <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
        </a>

        <a href="/admin/banners" class="group bg-white p-8 rounded-3xl shadow-sm border border-slate-200 hover:shadow-xl hover:border-pink-300 transition-all duration-300">
            <div class="flex items-center gap-6 mb-6">
                <div class="w-16 h-16 rounded-2xl bg-orange-100 text-orange-600 flex items-center justify-center group-hover:scale-110 transition-transform shadow-sm">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-slate-800 mb-1">Banner & Promosi</h3>
                    <p class="text-sm text-slate-500">Kelola slider gambar di halaman utama.</p>
                </div>
            </div>

             <div class="flex gap-2 overflow-hidden h-16">
                <% if(banners && banners.length > 0) { %>
                    <% banners.forEach(banner => { %>
                        <img src="<%= banner.imageUrl %>" class="w-24 h-full object-cover rounded-lg border border-slate-100">
                    <% }) %>
                <% } else { %>
                    <div class="w-full h-full bg-slate-100 rounded-lg flex items-center justify-center text-slate-400 text-[10px]">Belum ada banner</div>
                <% } %>
            </div>

            <div class="mt-6 flex items-center text-orange-600 font-bold text-sm group-hover:translate-x-2 transition-transform">
                Kelola Banner <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
        </a>

    </div>
</div>

<%- include('../layouts/admin-footer') %>