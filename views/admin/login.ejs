<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Secure Admin Access</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    @keyframes glow {
      0%, 100% { box-shadow: 0 0 15px rgba(34,211,238,0.4); }
      50% { box-shadow: 0 0 30px rgba(34,211,238,0.8); }
    }
    @keyframes scan {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(100%); }
    }
  </style>
</head>

<body class="min-h-screen bg-black text-cyan-400 flex items-center justify-center overflow-hidden font-mono">

  <!-- Background Grid -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_#0f172a,_#000)]"></div>

  <!-- Animated Scanline -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute w-full h-1 bg-cyan-400/10 animate-[scan_6s_linear_infinite]"></div>
  </div>

  <!-- Login Card -->
  <div class="relative z-10 w-full max-w-sm">

    <div class="bg-slate-900/80 backdrop-blur-xl border border-cyan-400/20 rounded-2xl p-8 animate-[glow_4s_ease-in-out_infinite]">

      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold tracking-widest text-cyan-300">
          ADMIN ACCESS
        </h1>
        <p class="text-xs text-cyan-500 mt-2 tracking-wide">
          OFFICIALGAMES.ID SECURE NODE
        </p>
      </div>

      <!-- Google Login -->
      <a href="/auth/google"
        class="relative overflow-hidden group flex items-center justify-center gap-3 w-full border border-cyan-400/30 text-cyan-300 py-3 rounded-xl transition-all duration-300 hover:bg-cyan-400/10 hover:border-cyan-400">

        <!-- Hover Scan Effect -->
        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></span>

        <!-- Google Icon -->
        <svg class="w-5 h-5 z-10" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>

        <span class="z-10 text-sm tracking-wider">
          LOGIN VIA GOOGLE
        </span>
      </a>

      <!-- Footer Note -->
      <p class="mt-6 text-center text-[11px] text-cyan-500/60">
        Authorized accounts only · Activity monitored
      </p>

    </div>

    <!-- Bottom Label -->
    <div class="mt-6 text-center text-[10px] text-cyan-500/40 tracking-widest">
      CYBER SECURITY INTERFACE v1.0
    </div>

  </div>

</body>
</html>
