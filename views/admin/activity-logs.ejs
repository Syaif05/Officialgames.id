<%- include('../layouts/admin-header', { currentPath: '/activity-logs' }) %>

<div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="/admin/database" class="text-xs text-slate-400 font-bold uppercase tracking-wider hover:text-indigo-600 mb-2 block">← Kembali ke Hub Database</a>
            <h2 class="text-3xl font-extrabold text-slate-800">Audit Aktivitas Global</h2>
        </div>
    </div>

    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 mb-6 flex gap-4">
        <div class="flex-1 relative">
            <form action="/admin/activity-logs" method="GET">
                <input type="text" name="q" value="<%= search %>" placeholder="Cari email, aktivitas, atau nama..." class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-50 border-none focus:ring-2 focus:ring-indigo-500 transition outline-none">
                <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </form>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-slate-50 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Waktu</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Aksi</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Target</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Keterangan</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Eksekutor</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                <% if(logs.length === 0) { %>
                    <tr><td colspan="5" class="text-center py-12 text-slate-400 italic">Tidak ada aktivitas ditemukan.</td></tr>
                <% } %>
                <% logs.forEach(log => { %>
                    <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4 text-xs text-slate-500 font-mono">
                            <%= new Date(log.timestamp).toLocaleString('id-ID', {day:'numeric', month:'short', hour:'2-digit', minute:'2-digit'}) %>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 rounded text-[10px] font-bold uppercase
                                <%= log.action === 'JOIN' ? 'bg-green-100 text-green-700' : 
                                   (log.action === 'LEFT' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700') %>">
                                <%= log.action %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm font-bold text-slate-700">
                            <%= log.targetName || log.targetEmail %>
                            <div class="text-[10px] text-slate-400 font-mono font-normal"><%= log.targetEmail %></div>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-600 truncate max-w-xs">
                            <%= log.details %>
                        </td>
                        <td class="px-6 py-4 text-xs text-slate-500">
                            <%= log.performedBy ? log.performedBy.split('@')[0] : 'System' %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <% if(totalPages > 1) { %>
            <div class="flex justify-between items-center p-4 bg-slate-50 border-t border-slate-100">
                <div class="text-xs text-slate-500">Hal <%= currentPage %> dari <%= totalPages %></div>
                <div class="flex gap-2">
                    <% if(currentPage > 1) { %> <a href="?page=<%= currentPage - 1 %>&q=<%= search %>" class="px-3 py-1 bg-white border border-slate-300 rounded text-xs hover:bg-slate-100">Prev</a> <% } %>
                    <% if(currentPage < totalPages) { %> <a href="?page=<%= currentPage + 1 %>&q=<%= search %>" class="px-3 py-1 bg-white border border-slate-300 rounded text-xs hover:bg-slate-100">Next</a> <% } %>
                </div>
            </div>
        <% } %>
    </div>
</div>

<%- include('../layouts/admin-footer') %>