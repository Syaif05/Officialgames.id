<%- include('../layouts/admin-header', { currentPath: '/settings' }) %>

<div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="/admin/system" class="text-xs text-slate-400 font-bold uppercase tracking-wider hover:text-indigo-600 mb-2 block">← Kembali ke Hub System</a>
            <h2 class="text-3xl font-extrabold text-slate-800">Konfigurasi Global</h2>
            <p class="text-slate-500 mt-1">Atur informasi kontak dan identitas website Anda.</p>
        </div>
        
        <% if (msg) { %>
            <div class="px-4 py-2 bg-green-100 text-green-800 rounded-lg text-sm font-bold flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <%= msg %>
            </div>
        <% } %>
    </div>

    <form action="/admin/settings" method="POST">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="lg:col-span-2 space-y-8">
                
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
                    <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">🆔</span>
                        Identitas Website
                    </h3>
                    
                    <div class="space-y-5">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Judul Website (Title)</label>
                            <input type="text" name="siteTitle" value="<%= setting ? setting.siteTitle : '' %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none transition" placeholder="Officialgames.id">
                            <p class="text-xs text-slate-400 mt-1">Judul yang muncul di tab browser dan hasil pencarian Google.</p>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Deskripsi Website (SEO)</label>
                            <textarea name="siteDescription" rows="4" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none transition" placeholder="Pusat database game terlengkap..."><%= setting ? setting.siteDescription : '' %></textarea>
                            <p class="text-xs text-slate-400 mt-1">Deskripsi singkat untuk SEO (Search Engine Optimization).</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
                    <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <span class="w-8 h-8 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center text-lg">🔗</span>
                        Link Penjualan
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Link Shopee</label>
                            <div class="flex">
                                <span class="inline-flex items-center px-3 rounded-l-xl border border-r-0 border-slate-200 bg-slate-50 text-gray-500 text-sm">🛒</span>
                                <input type="text" name="shopeeLink" value="<%= setting ? setting.shopeeLink : '' %>" class="w-full px-4 py-3 rounded-r-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 outline-none transition" placeholder="https://shopee.co.id/...">
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Link Lynk.id</label>
                            <div class="flex">
                                <span class="inline-flex items-center px-3 rounded-l-xl border border-r-0 border-slate-200 bg-slate-50 text-gray-500 text-sm">🔗</span>
                                <input type="text" name="lynkidLink" value="<%= setting ? setting.lynkidLink : '' %>" class="w-full px-4 py-3 rounded-r-xl border border-slate-200 focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="https://lynk.id/...">
                            </div>
                        </div>
                    </div>
                    <p class="text-xs text-slate-400 mt-4 bg-yellow-50 p-3 rounded-lg border border-yellow-100 text-yellow-700">
                        Link ini akan digunakan pada tombol di halaman detail produk (Popup Modal).
                    </p>
                </div>

            </div>

            <div class="space-y-8">
                
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
                    <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <span class="w-8 h-8 rounded-lg bg-green-50 text-green-600 flex items-center justify-center text-lg">📞</span>
                        Kontak Utama
                    </h3>
                    
                    <div class="space-y-5">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Nomor WhatsApp Admin</label>
                            <input type="text" name="contactWa" value="<%= setting ? setting.contactWa : '' %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-green-500 outline-none transition font-mono" placeholder="628123456789">
                            <p class="text-xs text-slate-400 mt-1">Gunakan format internasional tanpa tanda tambah (contoh: 628...).</p>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Email Support</label>
                            <input type="email" name="contactEmail" value="<%= setting ? setting.contactEmail : '' %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none transition" placeholder="admin@domain.com">
                        </div>
                    </div>
                </div>

                <div class="bg-slate-800 rounded-2xl shadow-lg p-8 text-white">
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                        <span class="w-8 h-8 rounded-lg bg-slate-700 flex items-center justify-center text-lg">🛡️</span>
                        Admin Whitelist
                    </h3>
                    <p class="text-slate-400 text-sm mb-4">Daftar email yang diizinkan mengakses dashboard ini (Diatur di file .env).</p>
                    
                    <div class="bg-slate-900 rounded-xl p-4 font-mono text-xs text-green-400 border border-slate-700 break-all">
                        <% if(user && user.email) { %>
                            <div class="mb-2 pb-2 border-b border-slate-700">
                                <span class="text-slate-500">Anda Login Sebagai:</span><br>
                                <%= user.email %>
                            </div>
                        <% } %>
                        <span class="text-slate-500">System Admin:</span><br>
                        (Lihat file .env di server)
                    </div>
                </div>

                <button type="submit" class="w-full bg-indigo-600 text-white py-4 rounded-xl font-bold text-lg shadow-xl shadow-indigo-200 hover:bg-indigo-700 transition transform hover:-translate-y-1 flex justify-center items-center gap-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                    Simpan Semua Pengaturan
                </button>

            </div>
        </div>
    </form>
</div>

<%- include('../layouts/admin-footer') %>