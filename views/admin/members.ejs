<%- include('../layouts/admin-header', { currentPath: '/members' }) %>

<div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <a href="/admin/database" class="text-xs text-slate-400 font-bold uppercase tracking-wider hover:text-indigo-600 mb-2 block">← Kembali ke Hub Database</a>
            <h2 class="text-3xl font-extrabold text-slate-800">Kelola Anggota</h2>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <% if (typeof viewMode !== 'undefined' && viewMode === 'groups') { %>
            <%- include('components/member-groups') %>
        <% } else { %>
            <%- include('components/member-list') %>
        <% } %>
    </div>
</div>

<%- include('../layouts/admin-footer') %>