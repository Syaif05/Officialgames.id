<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/images/logo-web.png">
    <title><%= (typeof drive !== 'undefined' && drive.name) ? drive.name : 'Official Games' %> | Katalog Premium</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: { 400: '#FFC107', 500: '#FFB300', 600: '#FFA000' }
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        html { scroll-behavior: smooth; } 
        [x-cloak] { display: none !important; }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col" 
      x-data="{ 
          fileModalOpen: false, 
          selectedFile: null,
          openFile(file) {
              this.selectedFile = file;
              this.fileModalOpen = true;
          }
      }">

    <%- include('components/navbar') %>

    <% 
        // --- LOGIKA AMAN UNTUK JUDUL (Server Side) ---
        // Kita pastikan variabel tidak undefined sebelum dipakai
        const safeDriveName = (typeof drive !== 'undefined' && drive.name) ? drive.name : 'Database';
        const safeFolderName = (typeof currentFolderName !== 'undefined' && currentFolderName) ? currentFolderName : safeDriveName;
        const isRoot = (typeof currentFolderId !== 'undefined' && typeof drive !== 'undefined' && currentFolderId === drive.rootFolderId);
        const isSearch = (typeof searchQuery !== 'undefined' && searchQuery);
        
        let displayTitle = safeFolderName;
        if (isSearch) displayTitle = 'Hasil Pencarian: \"' + searchQuery + '\"';
        else if (isRoot) displayTitle = safeDriveName;
    %>

    <header class="relative pt-24 pb-10 overflow-hidden bg-white border-b border-gray-100 shadow-sm z-10">
        <div class="absolute inset-0 opacity-5 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-gold-400 rounded-full blur-3xl opacity-10 animate-pulse"></div>

        <div class="container mx-auto px-6 relative z-10">
            <nav class="flex items-center text-sm text-gray-500 mb-6 overflow-x-auto whitespace-nowrap pb-2">
                <a href="/" class="hover:text-gold-600 transition flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                    Beranda
                </a>
                <span class="mx-2 text-gray-300">/</span>
                <a href="/view/<%= drive.slug %>" class="hover:text-gold-600 transition font-medium"><%= safeDriveName %></a>
                
                <% if (!isRoot) { %>
                    <span class="mx-2 text-gray-300">/</span>
                    <span class="text-gold-600 font-bold truncate max-w-[150px] md:max-w-md">
                        <%= isSearch ? 'Pencarian' : safeFolderName %>
                    </span>
                <% } %>
            </nav>

            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-2 flex items-center gap-3">
                        <% if (isSearch) { %>
                            <span class="text-4xl"></span> <%= displayTitle %>
                        <% } else if (isRoot) { %>
                            <span class="text-4xl"></span> <%= displayTitle %>
                        <% } else { %>
                            <span class="text-4xl"></span> <%= displayTitle %>
                        <% } %>
                    </h1>
                    <p class="text-gray-500 flex items-center gap-2 pl-1">
                        <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                        Status: <span class="font-semibold text-green-600">Online</span>  <%= drive.totalFiles || 0 %> Item Tersedia
                    </p>
                </div>

                <form action="/view/<%= drive.slug %>" method="GET" class="w-full md:w-80 relative group">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400 group-hover:text-gold-500 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input type="text" name="q" value="<%= searchQuery || '' %>" placeholder="Cari file..." 
                           class="block w-full pl-10 pr-3 py-3 border border-gray-200 rounded-xl leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-gold-400 focus:border-gold-400 sm:text-sm transition shadow-sm group-hover:shadow-md">
                    <% if (!isSearch) { %>
                        <input type="hidden" name="folder" value="<%= currentFolderId %>">
                    <% } %>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-grow container mx-auto px-6 py-8">
        
        <div class="flex items-center justify-between mb-6">
            <% if (backLink && !isSearch) { %>
                <a href="/view/<%= drive.slug %>?folder=<%= backLink %>" 
                   class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-semibold text-gray-600 hover:border-gold-400 hover:text-gold-600 hover:shadow transition transform hover:-translate-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"></path></svg>
                    Kembali
                </a>
            <% } else { %>
                <div></div>
            <% } %>
            
            <% if (isSearch) { %>
                <a href="/view/<%= drive.slug %>" class="px-4 py-2 bg-red-50 text-red-600 rounded-lg text-sm font-bold hover:bg-red-100 transition flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    Reset Pencarian
                </a>
            <% } %>
        </div>

        <% if (files.length === 0) { %>
            <div class="bg-white rounded-2xl border-2 border-dashed border-gray-200 p-16 text-center">
                <div class="text-6xl mb-4 opacity-50"></div>
                <h3 class="text-xl font-bold text-gray-900">Folder Kosong</h3>
                <p class="text-gray-500 mt-2">Belum ada file yang diunggah di sini.</p>
            </div>
        <% } %>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6">
            <% files.forEach(file => { %>
                <% 
                    const isFolder = file.mimeType === 'application/vnd.google-apps.folder';
                    
                    // --- LOGIKA DETEKSI IKON CANGGIH ---
                    let iconColor = 'text-gray-400';
                    let iconBg = 'bg-gray-50';
                    let iconType = 'default';
                    const mime = file.mimeType.toLowerCase();
                    const name = file.name.toLowerCase();

                    if (isFolder) {
                        iconColor = 'text-gold-500'; iconBg = 'bg-gold-50'; iconType = 'folder';
                    } else if (mime.includes('image')) {
                        iconColor = 'text-purple-500'; iconBg = 'bg-purple-50'; iconType = 'image';
                    } else if (mime.includes('video')) {
                        iconColor = 'text-red-500'; iconBg = 'bg-red-50'; iconType = 'video';
                    } else if (mime.includes('audio')) {
                        iconColor = 'text-pink-500'; iconBg = 'bg-pink-50'; iconType = 'audio';
                    } else if (mime.includes('pdf')) {
                        iconColor = 'text-red-600'; iconBg = 'bg-red-50'; iconType = 'pdf';
                    } else if (mime.includes('word') || name.endsWith('.doc') || name.endsWith('.docx')) {
                        iconColor = 'text-blue-600'; iconBg = 'bg-blue-50'; iconType = 'word';
                    } else if (mime.includes('spreadsheet') || name.endsWith('.xls') || name.endsWith('.xlsx')) {
                        iconColor = 'text-green-600'; iconBg = 'bg-green-50'; iconType = 'excel';
                    } else if (mime.includes('presentation') || name.endsWith('.ppt') || name.endsWith('.pptx')) {
                        iconColor = 'text-orange-600'; iconBg = 'bg-orange-50'; iconType = 'ppt';
                    } else if (mime.includes('zip') || mime.includes('rar') || mime.includes('compressed')) {
                        iconColor = 'text-amber-600'; iconBg = 'bg-amber-50'; iconType = 'archive';
                    } else if (mime.includes('android') || name.endsWith('.apk')) {
                        iconColor = 'text-green-500'; iconBg = 'bg-green-50'; iconType = 'android';
                    } else if (mime.includes('text') || name.endsWith('.txt')) {
                        iconColor = 'text-gray-500'; iconBg = 'bg-gray-100'; iconType = 'text';
                    }
                %>
                
                <a href="<%= isFolder ? `/view/${drive.slug}?folder=${file.driveId}` : '#' %>" 
                   <% if (!isFolder) { %> 
                        @click.prevent="openFile({ 
                            name: '<%= file.name %>', 
                            size: '<%= formatBytes(file.size) %>', 
                            mime: '<%= file.mimeType %>',
                            iconType: '<%= iconType %>' 
                        })"
                   <% } %>
                   class="group relative bg-white rounded-2xl p-4 border border-gray-100 shadow-sm hover:shadow-xl hover:border-gold-300 transition-all duration-300 flex flex-col justify-between h-full cursor-pointer transform hover:-translate-y-1">
                    
                    <div class="mb-3 relative">
                        <div class="w-full aspect-[4/3] <%= iconBg %> rounded-xl flex items-center justify-center group-hover:scale-[1.02] transition duration-300 relative overflow-hidden">
                            
                            <% if (!isFolder) { %>
                                <div class="absolute top-2 right-2 bg-gray-900/80 backdrop-blur text-white text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1 z-10 shadow-sm">
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                    Premium
                                </div>
                            <% } %>

                            <svg class="w-14 h-14 <%= iconColor %> drop-shadow-sm transition duration-300" fill="currentColor" viewBox="0 0 24 24">
                                <% if (iconType === 'folder') { %>
                                    <path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"></path>
                                <% } else if (iconType === 'image') { %>
                                    <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"></path>
                                <% } else if (iconType === 'video') { %>
                                    <path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"></path>
                                <% } else if (iconType === 'audio') { %>
                                    <path d="M12 3v9.28c-.47-.17-.97-.28-1.5-.28C8.01 12 6 14.01 6 16.5S8.01 21 10.5 21c2.31 0 4.2-1.75 4.45-4H15V6h4V3h-7z"></path>
                                <% } else if (iconType === 'pdf') { %>
                                    <path d="M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8.5 7.5c0 .83-.67 1.5-1.5 1.5H9v2H7.5V7H10c.83 0 1.5.67 1.5 1.5v2.5zm5 2c0 .83-.67 1.5-1.5 1.5h-2.5V7H15c.83 0 1.5.67 1.5 1.5v3zm4-3H19v1h1.5V11H19v2h-1.5V7h3v1.5zM9 9.5h1v-1H9v1zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm10 5.5h1v-3h-1v3z"></path>
                                <% } else if (iconType === 'word') { %>
                                    <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"></path>
                                <% } else if (iconType === 'excel') { %>
                                    <path d="M14.67 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V7.33l-5.33-5.33zM13 18h-2v-4h2v4zm0-6h-2v-2h2v2zm-4 6H7v-4h2v4zm0-6H7v-2h2v2zm6 6h-2v-4h2v4zm0-6h-2v-2h2v2zm.33-5.5L18.83 10h-3.5V6.5z"></path>
                                <% } else if (iconType === 'ppt') { %>
                                    <path d="M4 6h16v12H4z" fill="none"></path><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"></path>
                                <% } else if (iconType === 'archive') { %>
                                    <path d="M20 6h-4V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM10 4h4v2h-4V4zm10 16H4V8h16v12zM12 10l-2 2 2 2 2-2-2-2z"></path>
                                <% } else if (iconType === 'android') { %>
                                    <path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.8-3.19c.09-.15.04-.34-.11-.43-.15-.09-.34-.04-.43.11l-1.8 3.2c-1.93-.86-4.14-.86-6.06 0l-1.8-3.2c-.09-.15-.28-.2-.43-.11-.15.09-.2.28-.11.43l1.8 3.19C6.22 3.63 3.32 6.54 3 10h18c-.32-3.46-3.22-6.37-6.97-7.84z"></path>
                                <% } else { %>
                                    <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"></path>
                                <% } %>
                            </svg>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-sm font-bold text-gray-800 group-hover:text-gold-600 line-clamp-2 leading-snug mb-1" title="<%= file.name %>">
                            <%= file.name %>
                        </h3>
                        
                        <div class="flex items-center justify-between text-xs text-gray-400 mt-2">
                            <% if (isFolder) { %>
                                <span class="bg-gold-50 text-gold-700 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider">Folder</span>
                            <% } else { %>
                                <span class="font-medium"><%= formatBytes(file.size) %></span>
                                <span class="uppercase text-[10px] bg-gray-100 px-1.5 rounded truncate max-w-[50px]"><%= file.mimeType.split('/').pop().substring(0,4) %></span>
                            <% } %>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>

        <% if (pagination && pagination.total > 1) { %>
            <div class="mt-12 flex justify-center">
                <div class="inline-flex bg-white rounded-xl shadow-sm border border-gray-200 p-1 gap-1">
                    <% if (pagination.page > 1) { %>
                        <a href="?folder=<%= currentFolderId %>&q=<%= searchQuery %>&page=<%= pagination.page - 1 %>" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100 transition"> Prev</a>
                    <% } %>
                    <div class="px-4 py-2 text-sm font-bold text-gold-600 bg-gold-50 rounded-lg">
                        Hal <%= pagination.page %>
                    </div>
                    <% if (pagination.page < pagination.total) { %>
                        <a href="?folder=<%= currentFolderId %>&q=<%= searchQuery %>&page=<%= pagination.page + 1 %>" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100 transition">Next </a>
                    <% } %>
                </div>
            </div>
        <% } %>

    </main>

    <%- include('components/footer') %>

    <div x-show="fileModalOpen" x-cloak 
         class="fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/70 backdrop-blur-sm px-4"
         x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
         
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden relative transform transition-all"
             @click.away="fileModalOpen = false"
             x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 scale-95 translate-y-4" x-transition:enter-end="opacity-100 scale-100 translate-y-0">
            
            <div class="bg-gradient-to-r from-gray-900 to-gray-800 p-6 text-center relative overflow-hidden">
                <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
                <button @click="fileModalOpen = false" class="absolute top-4 right-4 text-gray-400 hover:text-white transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>

                <div class="w-16 h-16 bg-white/10 backdrop-blur rounded-2xl flex items-center justify-center mx-auto mb-4 border border-white/20">
                    <span class="text-3xl"></span>
                </div>
                <h3 class="text-xl font-bold text-white relative z-10">Akses Terkunci</h3>
                <p class="text-gray-300 text-sm mt-1 relative z-10">Konten Premium</p>
            </div>

            <div class="p-6">
                <div class="bg-gray-50 rounded-xl p-4 mb-6 border border-gray-100 flex items-center gap-3">
                    <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm text-lg">
                        <span x-show="selectedFile?.iconType === 'image'"></span>
                        <span x-show="selectedFile?.iconType === 'video'"></span>
                        <span x-show="selectedFile?.iconType === 'audio'"></span>
                        <span x-show="selectedFile?.iconType === 'archive'"></span>
                        <span x-show="selectedFile?.iconType === 'pdf'"></span>
                        <span x-show="selectedFile?.iconType === 'word'"></span>
                        <span x-show="selectedFile?.iconType === 'excel'"></span>
                        <span x-show="selectedFile?.iconType === 'ppt'"></span>
                        <span x-show="selectedFile?.iconType === 'android'"></span>
                        <span x-show="selectedFile?.iconType === 'text'"></span>
                        <span x-show="selectedFile?.iconType === 'default'"></span>
                    </div>
                    <div class="overflow-hidden text-left">
                        <h4 class="font-bold text-gray-800 text-sm truncate" x-text="selectedFile?.name"></h4>
                        <p class="text-xs text-gray-500" x-text="selectedFile?.size + '  ' + (selectedFile?.mime?.split('/').pop() || 'File')"></p>
                    </div>
                </div>

                <p class="text-center text-gray-600 mb-6 text-sm">
                    Untuk mendownload file ini, silakan hubungi admin atau beli akses member via marketplace.
                </p>

                <% 
                    // Logika WA (Server Side)
                    let cleanWa = (site.waNumber || '').toString().replace(/\D/g, ''); 
                    if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
                    const waMsg = `Halo Admin, saya ingin membeli akses untuk database: ${drive.name}. Mohon infonya.`;
                    const waLink = `https://wa.me/${cleanWa}?text=${encodeURIComponent(waMsg)}`;
                %>

                <div class="space-y-3">
                    <% if (site.shopeeUrl) { %>
                        <a href="<%= site.shopeeUrl %>" target="_blank" class="flex items-center justify-center gap-3 w-full py-3 bg-white border border-orange-200 rounded-xl hover:bg-orange-50 transition group shadow-sm">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/f/fe/Shopee.svg" class="h-6 opacity-80 group-hover:opacity-100 transition">
                            <span class="font-bold text-orange-600">Order via Shopee</span>
                        </a>
                    <% } %>

                    <% if (site.lynkUrl) { %>
                        <a href="<%= site.lynkUrl %>" target="_blank" class="flex items-center justify-center gap-3 w-full py-3 bg-white border border-blue-200 rounded-xl hover:bg-blue-50 transition group shadow-sm">
                            <div class="w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-xs font-bold">L</div>
                            <span class="font-bold text-blue-600">Order via Lynk.id</span>
                        </a>
                    <% } %>

                    <a href="<%= waLink %>" target="_blank" class="flex items-center justify-center gap-3 w-full py-3 bg-green-600 text-white rounded-xl hover:bg-green-700 transition shadow-lg transform hover:-translate-y-0.5">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" class="h-6 w-6 brightness-0 invert">
                        <span class="font-bold">Chat Admin (Fast Resp)</span>
                    </a>
                </div>

                <button @click="fileModalOpen = false" class="mt-6 w-full text-center text-sm text-gray-400 hover:text-gray-600 transition">
                    Tutup
                </button>
            </div>
        </div>
    </div>

</body>
</html>
